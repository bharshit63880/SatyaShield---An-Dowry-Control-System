HOST=0.0.0.0
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY_MODE=none
MONGODB_URI=mongodb://127.0.0.1:27017/dahej-control-system
SERVER_PUBLIC_URL=http://localhost:5000
UPLOADS_DIR=uploads
JWT_SECRET=change-this-super-secret-key-with-at-least-32-chars
REPORTER_ACCESS_HMAC_KEY=change-this-independent-reporter-hmac-key-32-chars-minimum
CASE_INTEGRITY_HMAC_KEY=change-this-distinct-case-integrity-hmac-key-32-chars-minimum
REPORTER_TOKEN_SECRET=change-this-independent-reporter-token-key-32-chars-minimum
REPORTER_TOKEN_AUDIENCE=satyashield-reporter-case
REPORTER_TOKEN_EXPIRES_IN=15m
STAFF_ACCESS_TOKEN_SECRET=change-this-independent-staff-access-token-key-32-chars-minimum
STAFF_ACCESS_TOKEN_EXPIRES_IN=10m
STAFF_TOKEN_KEY_ID=staff-v1
REFRESH_TOKEN_PEPPER=change-this-independent-refresh-token-pepper-32-chars-minimum
VERIFICATION_TOKEN_PEPPER=change-this-independent-verification-pepper-32-chars-minimum
PASSWORD_RESET_TOKEN_PEPPER=change-this-independent-reset-pepper-32-chars-minimum
MFA_CHALLENGE_TOKEN_PEPPER=change-this-independent-mfa-challenge-pepper-32-chars-minimum
RECOVERY_CODE_PEPPER=change-this-independent-recovery-code-pepper-32-chars-minimum
MFA_ENCRYPTION_KEY=replace-with-a-different-64-hex-character-key
REFRESH_TOKEN_EXPIRES_DAYS=7
VERIFICATION_TOKEN_EXPIRES_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
MFA_CHALLENGE_EXPIRES_MINUTES=5
AUTH_COOKIE_NAME=ss_refresh
CSRF_COOKIE_NAME=ss_csrf
JWT_ISSUER=dahej-control-system
JWT_AUDIENCE=dahej-control-system-admin
LOCATION_ENCRYPTION_KEY=change-this-location-encryption-key
EVIDENCE_ENCRYPTION_KEY=replace-with-64-hex-characters-from-a-secure-random-generator
EVIDENCE_ENCRYPTION_VERSION=1
EVIDENCE_STORAGE_DIR=private-data/evidence
EVIDENCE_MAX_FILE_SIZE=31457280
EVIDENCE_SCANNER_MODE=development-bypass
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
CLIENT_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_PROCESSING_ENABLED=false
AI_DISCLOSURE_VERSION=ai-2026-07-v1
PRIVACY_NOTICE_VERSION=privacy-2026-07-v1
CONSENT_VERSION=consent-2026-07-v1
RETENTION_POLICY_VERSION=retention-2026-07-v1
RETENTION_ENFORCEMENT_ENABLED=false
COMPLAINT_RETENTION_DAYS=730
EVIDENCE_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=365
CASE_INTEGRITY_POLICY_VERSION=case-integrity-v1
CASE_INTEGRITY_FINGERPRINT_VERSION=narrative-hmac-v1
CASE_INTEGRITY_DUPLICATE_WINDOW_DAYS=90
NGO_ROUTING_POLICY_VERSION=ngo-routing-v1
NGO_ASSIGNMENT_OFFER_MINUTES=60
NGO_DEFAULT_MAX_ACTIVE_CASES=20
NGO_CAPACITY_ENFORCEMENT_ENABLED=true
NGO_REMOTE_COVERAGE_ENABLED=true
NGO_REVIEW_VERSION=ngo-review-v1
NGO_LEGACY_ASSIGNMENTS_ALLOWED=false
TRIAGE_POLICY_VERSION=triage-policy-v1
TRIAGE_INPUT_SCHEMA_VERSION=triage-input-v1
TRIAGE_CRITICAL_RULESET_VERSION=triage-critical-v1
TRIAGE_AI_ENABLED=false
TRIAGE_AI_PROVIDER=
TRIAGE_AI_MODEL=
TRIAGE_AI_POLICY_VERSION=
TRIAGE_AI_DISCLOSURE_VERSION=
TRIAGE_HUMAN_REVIEW_REQUIRED_FOR_CRITICAL=true
TRIAGE_LEGACY_VALUES_TRUSTED=false

# Phase 8 internal workflow targets; these are not guaranteed response times.
ESCALATION_POLICY_VERSION=escalation-policy-v1
ESCALATION_SCHEDULER_ENABLED=false
ESCALATION_SCHEDULER_DATABASE=
ESCALATION_SCHEDULER_INTERVAL_SECONDS=30
ESCALATION_BATCH_SIZE=50
ESCALATION_LEASE_SECONDS=60
ESCALATION_MAX_ATTEMPTS=5
ESCALATION_TIMEZONE=UTC
CRITICAL_REVIEW_TARGET_MINUTES=15
HIGH_REVIEW_TARGET_MINUTES=120
NGO_OFFER_RESPONSE_TARGET_MINUTES=60
NO_MATCH_REVIEW_TARGET_MINUTES=60

# Phase 9 real-time chat. Memory adapter is single-instance only.
SOCKET_IO_ENABLED=false
SOCKET_SINGLE_INSTANCE_MODE=true
SOCKET_ADAPTER=memory
SOCKET_MESSAGE_MAX_LENGTH=2000
SOCKET_MESSAGE_RATE_LIMIT=20
SOCKET_HISTORY_PAGE_SIZE=50
SOCKET_AUTH_RECHECK_SECONDS=30

# Phase 10 SOS is internal only; external delivery must remain disabled.
SOS_POLICY_VERSION=sos-policy-v1
SOS_ENABLED=false
SOS_CONFIRMATION_SECONDS=5
SOS_ACTIVE_EXPIRY_MINUTES=1440
SOS_LOCATION_ENABLED=false
SOS_INTERNAL_ROUTING_ENABLED=true
SOS_EXTERNAL_DELIVERY_ENABLED=false
HELPLINE_DIRECTORY_VERSION=helpline-directory-v1
HELPLINE_MAX_REVIEW_AGE_DAYS=180
